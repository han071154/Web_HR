PORT=4000
DATABASE_URL=postgres://web_hr:web_hr_password@localhost:5432/web_hr
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
AVATAR_UPLOAD_DIR=uploads/avatars
AVATAR_MAX_SIZE_MB=5
CV_UPLOAD_DIR=storage/cvs
CV_MAX_SIZE_MB=5
EXCEL_MAX_SIZE_MB=10
# Gioi han tong gio lam/tuan khi xep lich ca lam viec (HR-030).
MAX_WEEKLY_WORK_HOURS=48
# Check-in tre hon gio bat dau ca qua so phut nay thi tinh la di tre (HR-035).
LATE_THRESHOLD_MINUTES=15
# Khong co lich phan ca cho ngay cham cong thi dung so gio nay de tinh gio OT (HR-036).
DEFAULT_STANDARD_WORK_HOURS=8
# Mui gio cong ty: xac dinh ngay cham cong va gio vao ca (khong theo gio UTC cua may chu).
APP_TIMEZONE=Asia/Ho_Chi_Minh
