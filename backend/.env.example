PORT=4000
DATABASE_URL=postgres://web_hr:web_hr_password@localhost:5432/web_hr
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
AVATAR_UPLOAD_DIR=uploads/avatars
AVATAR_MAX_SIZE_MB=5
CV_UPLOAD_DIR=storage/cvs
CV_MAX_SIZE_MB=5
EXCEL_MAX_SIZE_MB=10
# Gioi han tong gio lam/tuan khi xep lich ca lam viec (HR-030).
MAX_WEEKLY_WORK_HOURS=48
# Check-in tre hon gio bat dau ca qua so phut nay thi tinh la di tre (HR-035).
LATE_THRESHOLD_MINUTES=15
# Check-out som hon gio ket thuc ca qua so phut nay thi tinh la ve som (HR-035).
EARLY_LEAVE_THRESHOLD_MINUTES=15
# true: moi gio tu ghi Vang cho ca da xep cua ngay hom truoc ma khong cham cong (HR-035).
AUTO_MARK_ABSENT=false
# Khong co lich phan ca cho ngay cham cong thi dung so gio nay de tinh gio OT (HR-036).
DEFAULT_STANDARD_WORK_HOURS=8
# Khong co lich phan ca thi tru so phut nghi giua ca nay khi tinh gio cong (BUG-26).
DEFAULT_BREAK_MINUTES=60
# Mui gio cong ty: xac dinh ngay cham cong va gio vao ca (khong theo gio UTC cua may chu).
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Log he thong: LOG_FORMAT=json|pretty (mac dinh json khi NODE_ENV=production), LOG_LEVEL=debug|info|warn|error.
LOG_FORMAT=pretty
LOG_LEVEL=info
# Tuy chon: ghi them log ra file theo ngay (logs/app-YYYY-MM-DD.log), giu LOG_RETENTION_DAYS ngay.
LOG_FILE=
LOG_RETENTION_DAYS=14
