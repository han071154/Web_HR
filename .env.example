# Biến môi trường cho `docker compose up` (xem docker-compose.yml và docs/DEPLOYMENT.md).
# Copy file này thành ".env" cùng cấp và điền giá trị thật — KHÔNG commit ".env" thật lên git.

# Bắt buộc đổi trước khi chạy ở staging/production.
JWT_SECRET=change_this_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production

# Domain/IP thật của frontend khi deploy (dùng để backend chấp nhận CORS nếu không đi qua
# Nginx reverse proxy của frontend). Mặc định chỉ cho phép http://localhost:8080.
CORS_ORIGIN=http://localhost:8080

# "/api" (mặc định) để Nginx của frontend tự proxy sang service backend. Chỉ đổi thành URL tuyệt
# đối (vd https://api.example.com/api) nếu frontend và backend không được deploy cùng compose.
VITE_API_URL=/api

# Cổng expose ra host, đổi nếu bị trùng cổng trên máy chủ.
BACKEND_PORT=4000
FRONTEND_PORT=8080
