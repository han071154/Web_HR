# Cấu hình môi trường STAGING (copy thành ".env.staging" trên máy chủ staging, KHÔNG commit file thật).
# Chạy: ./scripts/deploy.sh .env.staging   (project docker compose "web-hr-staging", tách biệt production).

COMPOSE_PROJECT_NAME=web-hr-staging

# Bắt buộc đổi sang chuỗi ngẫu nhiên dài (vd: openssl rand -hex 32).
JWT_SECRET=change_me_staging_jwt_secret
JWT_REFRESH_SECRET=change_me_staging_refresh_secret
POSTGRES_PASSWORD=change_me_staging_db_password

# Domain/IP của frontend staging.
CORS_ORIGIN=http://localhost:8081
VITE_API_URL=/api

# Cổng expose ra host — khác production để chạy song song trên cùng máy.
FRONTEND_PORT=8081
BACKEND_PORT=4001
DB_PORT=5433

APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_FORMAT=json
LOG_LEVEL=info
AUTO_MARK_ABSENT=true

# true: nạp dữ liệu demo (database/sample-data.sql) sau khi tạo schema — chỉ dùng cho staging/demo.
LOAD_SAMPLE_DATA=true
